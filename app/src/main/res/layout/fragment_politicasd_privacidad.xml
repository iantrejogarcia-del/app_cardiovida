<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ventanas_cuenta.PoliticasdPrivacidadFragment">


    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="582dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="71dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="83dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Política de Privacidad de CARDIO VIDA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Recopilación de Datos"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La aplicación CARDIO VIDA recopila datos personales como nombre, edad, género, correo electrónico, y datos relacionados con la salud, como el riesgo de enfermedades cardiovasculares, calidad del sueño, salud mental y calorías consumidas. Estos datos se utilizan para calcular resultados y recomendaciones para mejorar el estilo de vida del usuario." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Uso de los Datos"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Los datos recopilados por CARDIO VIDA se utilizan exclusivamente para proporcionar cálculos de riesgo y recomendaciones relacionadas con la salud y el bienestar. No se comparten con terceros sin el consentimiento explícito del usuario." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Seguridad de los Datos"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Se han implementado medidas de seguridad adecuadas para proteger los datos del usuario, incluyendo el cifrado de datos y el acceso restringido a la información personal." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Consentimiento del Usuario"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El usuario de CARDIO VIDA otorga su consentimiento para la recopilación y uso de sus datos personales al utilizar la aplicación. El consentimiento se gestiona de acuerdo con las leyes de protección de datos aplicables." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Actualizaciones de la Política de Privacidad"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La política de privacidad de CARDIO VIDA puede actualizarse periódicamente. Se notificarán los cambios significativos y se solicitará nuevamente el consentimiento del usuario si es necesario." />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/btniVolver"
        android:layout_width="43dp"
        android:layout_height="37dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@color/white"
        android:src="@drawable/arrow_back" />
</RelativeLayout>