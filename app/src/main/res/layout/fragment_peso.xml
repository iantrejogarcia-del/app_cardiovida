<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vetnanas_inicio.ventanas_peso.PesoFragment"
    android:background="@drawable/gradient_backgroundd">

    <EditText
        android:id="@+id/etHeight"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="189dp"
        android:hint="Altura (cm)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/etAge"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/etHeight"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="76dp"
        android:layout_marginTop="71dp"
        android:layout_marginEnd="76dp"
        android:hint="Edad"
        android:inputType="number" />

    <EditText
        android:id="@+id/etWeight"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/etAge"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="76dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="76dp"
        android:hint="Peso (kg)"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/etWeight"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="120dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="120dp"
        android:text="Calcular"
        android:backgroundTint="@color/indian_red"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="346dp"
        android:layout_height="106dp"
        android:layout_below="@id/btnCalculate"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:visibility="invisible"
        android:textSize="18sp"
        android:textAlignment="center" />

    <ImageButton
        android:id="@+id/btniVolver"
        android:layout_width="43dp"
        android:layout_height="37dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@color/indian_red"
        android:src="@drawable/arrow_back" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/btniVolver"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="TU PESO IDEAL"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:layout_width="257dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="75dp"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="75dp"
        android:text="Ingresa tu altura en cm"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="257dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="75dp"
        android:layout_marginTop="275dp"
        android:layout_marginEnd="75dp"
        android:text="Ingresa tu edad"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="257dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="75dp"
        android:layout_marginTop="362dp"
        android:layout_marginEnd="75dp"
        android:text="Ingresa tu peso en kg"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"/>
</RelativeLayout>